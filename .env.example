DATABASE_HOST=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
PHX_HOST=localhost

# Not required while the deterministic fake AI provider is active.
OPENAI_API_KEY=

# Server-side Shopify Storefront API connection. Keep the private token only in .env.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Meta WhatsApp Cloud API. Leave blank to use the deterministic fake adapter.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
