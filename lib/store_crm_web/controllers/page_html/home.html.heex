<Layouts.app flash={@flash}>
  <section
    id="home-hero"
    class="overflow-hidden rounded-[2rem] border border-emerald-950/10 bg-emerald-950 px-6 py-14 text-white shadow-xl shadow-emerald-950/10 sm:px-12"
  >
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-emerald-100 ring-1 ring-white/15"><.icon
        name="hero-bolt"
        class="size-4"
      /> Comercio conversacional</span>
      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">
        Vende con contexto, no con suposiciones.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-emerald-100 sm:text-lg">
        Conecta el catálogo en vivo de Shopify con conversaciones trazables y rutas de pago seguras.
      </p>
      <.link
        navigate={~p"/shopify"}
        id="open-shopify-workspace"
        class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-lime-300 px-5 py-3 text-sm font-bold text-emerald-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-lime-200"
      >Abrir espacio de Shopify <.icon name="hero-arrow-right" class="size-4" /></.link>
    </div>
  </section>
</Layouts.app>
